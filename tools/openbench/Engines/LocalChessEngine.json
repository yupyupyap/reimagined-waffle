{
  "private": false,
  "nps": 1800000,
  "source": "https://github.com/REPLACE_ME/LocalChessEngine",
  "build": {
    "path": "tools/openbench",
    "compilers": [
      "clang++>=17.0.0"
    ],
    "cpuflags": [],
    "systems": [
      "Darwin"
    ]
  },
  "test_presets": {
    "default": {
      "base_branch": "main",
      "book_name": "UHO_4060_v2.epd",
      "test_bounds": "[0.00, 5.00]",
      "test_confidence": "[0.05, 0.05]",
      "win_adj": "movecount=3 score=400",
      "draw_adj": "movenumber=40 movecount=8 score=10"
    },
    "STC": {
      "both_options": "Threads=1 Hash=8",
      "both_time_control": "10.0+0.1",
      "workload_size": 32
    },
    "LTC": {
      "both_options": "Threads=1 Hash=64",
      "both_time_control": "60.0+0.6",
      "workload_size": 8
    },
    "STC Regression": {
      "both_options": "Threads=1 Hash=8",
      "both_time_control": "10.0+0.1",
      "workload_size": 32,
      "test_bounds": "[-3.00, 0.00]"
    },
    "LTC Regression": {
      "both_options": "Threads=1 Hash=64",
      "both_time_control": "60.0+0.6",
      "workload_size": 8,
      "test_bounds": "[-3.00, 0.00]"
    },
    "STC Fixed Games": {
      "both_options": "Threads=1 Hash=8",
      "both_time_control": "10.0+0.1",
      "workload_size": 32,
      "test_max_games": 40000
    },
    "LTC Fixed Games": {
      "both_options": "Threads=1 Hash=64",
      "both_time_control": "60.0+0.6",
      "workload_size": 8,
      "test_max_games": 40000
    }
  },
  "tune_presets": {
    "default": {
      "book_name": "UHO_4060_v2.epd",
      "win_adj": "movecount=3 score=400",
      "draw_adj": "movenumber=40 movecount=8 score=10"
    }
  },
  "datagen_presets": {
    "default": {
      "win_adj": "None",
      "draw_adj": "None",
      "workload_size": 128
    }
  }
}
